# SafeNet server settings. setup_server.sh copies this to safenet.env (chmod 600, gitignored).
# Shell variables win over this file.

# Where uvicorn listens. Keep 127.0.0.1 and reach it through tunnel.sh; a private IP only when
# a load balancer sits in front (README2.md, "Scaling out").
SAFENET_BIND=127.0.0.1
SAFENET_PORT=8000

# uvicorn worker processes. auto = CPUs - 1. On the 3-vCPU LinuxONE guest 3 measured best
# (bench/RESULTS.md); use 2 while a model is training there.
SAFENET_WORKERS=3

# Postgres connections per worker. servers x workers x pool must stay under max_connections (100).
SAFENET_DB_POOL_SIZE=5

# Written by setup_postgres.sh. run_api.sh refuses to start while it still says CHANGE_ME.
# SAFENET_DATABASE_URL=postgresql://safenet:CHANGE_ME@127.0.0.1:5432/safenet

# Seconds a request waits for a pooled Postgres connection before answering 503 + Retry-After.
SAFENET_DB_TIMEOUT_S=2

SAFENET_MAX_TEXT_LEN=2000
SAFENET_MAX_BATCH=100
SAFENET_LOG_LEVEL=info

# Analyses (sentences and scores, never stored) each worker keeps for repeated texts.
SAFENET_ANALYSIS_CACHE=4096

# Defaults: config/api_keys.toml and models/ next to the code. models/ must hold a pair trained on this
# machine's byte order (models/README.md); otherwise the fallback rules answer and /health says so.
# SAFENET_API_KEYS=/home/linux1/safenet/config/api_keys.toml
# SAFENET_MODELS_DIR=/home/linux1/safenet/models

# Accepts dev-<platform> as an API key. NEVER on the server.
SAFENET_DEV_KEYS=0
